{
  "name": "glide",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace @glide/web run dev",
    "build": "npm --workspace @glide/web run build",
    "start": "npm --workspace @glide/web run start",
    "check": "python3 scripts/check-install-docs.py",
    "verify": "npm run check && python3 scripts/update-font-metadata.py --check && python3 scripts/check-release-artifacts.py && npm run build",
    "verify:full": "npm run verify && python3 scripts/make-desktop-bundle.py --check"
  },
  "devDependencies": {
    "portless": "^0.15.4"
  },
  "packageManager": "npm@12.0.1"
}
